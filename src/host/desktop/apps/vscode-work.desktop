[Desktop Entry]
Type=Application
Version=1.0
Name=VS Code (Work)
Comment=Visual Studio Code from work_container
Exec=__RUNNER_BIN__ vscode %F
Icon=code
Terminal=false
Categories=Development;IDE;TextEditor;
MimeType=application/x-code-workspace;inode/directory;text/plain;
StartupNotify=true
StartupWMClass=com.microsoft.VSCode
Actions=new-empty-window;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=__RUNNER_BIN__ vscode --new-window %F
