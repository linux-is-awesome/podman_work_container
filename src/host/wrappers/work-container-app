#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/work_container/src/host-podman-exec

if [[ $# -lt 1 ]]; then
  echo "Usage: work-container-app <google-chrome|firefox|vscode|cursor|github-desktop|sf> [args...]" >&2
  exit 1
fi

SERVICE_NAME="work_container.service"
APP="${1}"
shift || true

if ! sudo podman ps --format '{{.Names}}' >/dev/null 2>&1; then
  echo "Cannot access root podman. Run: sudo -v" >&2
  exit 1
fi

ps_names="$(sudo podman ps --format '{{.Names}}' 2>/dev/null || true)"
if ! grep -qx 'work_container' <<< "${ps_names}"; then
  if ! sudo systemctl restart "${SERVICE_NAME}"; then
    echo "Failed to restart ${SERVICE_NAME}." >&2
    exit 1
  fi
fi

for _ in $(seq 1 30); do
  ps_names="$(sudo podman ps --format '{{.Names}}' 2>/dev/null || true)"
  if grep -qx 'work_container' <<< "${ps_names}"; then
    break
  fi
  sleep 1
done
if ! grep -qx 'work_container' <<< "${ps_names}"; then
  echo "work_container container is not running after service start." >&2
  exit 1
fi

case "${APP}" in
  google-chrome|chrome)
    # Flags before "$@" so desktop %U URLs stay valid Chromium args.
    CMD=(google-chrome-stable
      "--enable-features=UseOzonePlatform" "--ozone-platform-hint=auto" "--ozone-platform=wayland"
      "--font-render-hinting=full" "--class=Google-chrome-work" "--name=Google-chrome-work"
      "$@")
    ;;
  firefox)
    CMD=(firefox-esr "--class" "Firefox-work" "--name" "Firefox-work" "$@")
    ;;
  vscode|code)
    CMD=(code "$@")
    ;;
  cursor)
    CMD=(cursor "$@")
    ;;
  github-desktop|github)
    CMD=(github-desktop "$@")
    ;;
  sf|sfdx)
    CMD=(sf "$@")
    ;;
  *)
    echo "Unknown app: ${APP}" >&2
    exit 1
    ;;
esac

if [[ "${APP}" == "sf" ]] || [[ "${APP}" == "sfdx" ]]; then
  has_browser_flag=0
  for arg in "${CMD[@]}"; do
    if [[ "${arg}" == "--browser" ]] || [[ "${arg}" == --browser=* ]] || [[ "${arg}" == "-b" ]]; then
      has_browser_flag=1
      break
    fi
  done

  if [[ "${has_browser_flag}" -eq 0 ]] && [[ "${#CMD[@]}" -ge 2 ]]; then
    HELP_CMD=("${CMD[0]}")
    for ((i=1; i<${#CMD[@]}; i++)); do
      arg="${CMD[$i]}"
      if [[ "${arg}" == -* ]]; then
        break
      fi
      HELP_CMD+=("${arg}")
    done
    HELP_CMD+=(--help)

    WORK_CONTAINER_EXEC_STDIO=probe
    if work_container_exec_as_user -- "${HELP_CMD[@]}" 2>/dev/null | awk '/--browser/ {found=1} END {exit found?0:1}'; then
      CMD+=(--browser chrome)
    fi
    unset WORK_CONTAINER_EXEC_STDIO
  fi
fi

EXEC_ARGS=()
podman_append_gui_session_env EXEC_ARGS
if [[ -n "${PWD:-}" ]]; then
  EXEC_ARGS+=(--workdir "${PWD}")
fi

work_container_exec_as_user "${EXEC_ARGS[@]}" -- "${CMD[@]}"
