#!/usr/bin/env bash
# Shared host mount helpers for container launchers.

add_host_mounts() {
  local -n _mount_args="$1"
  local script_dir="$2"
  local host_home="$3"

  local runners_dir="${script_dir}/app-runners"
  if [[ -x "${runners_dir}/chrome-work-open" ]]; then
    _mount_args+=("-v" "${runners_dir}/chrome-work-open:/usr/local/bin/chrome-work-open:ro")
    _mount_args+=("-v" "${runners_dir}/chrome-work-open:/usr/local/bin/google-chrome:ro")
    _mount_args+=("-v" "${runners_dir}/chrome-work-open:/usr/bin/google-chrome-stable:ro")
  fi

  if [[ -x "${runners_dir}/vscode-work-open" ]]; then
    _mount_args+=("-v" "${runners_dir}/vscode-work-open:/usr/bin/code:ro")
  fi

  if [[ -x "${runners_dir}/cursor-work-open" ]]; then
    _mount_args+=("-v" "${runners_dir}/cursor-work-open:/usr/bin/cursor:ro")
  fi

  # Not /usr/bin/github-desktop: that symlink resolves to the Electron binary and
  # podman follows it, so the mount would overwrite the file the runner must exec.
  if [[ -x "${runners_dir}/github-desktop-work-open" ]]; then
    _mount_args+=("-v" "${runners_dir}/github-desktop-work-open:/usr/local/bin/github-desktop:ro")
  fi

  # Host-open bridges (src/host/host-open/):
  # - bin/* → /usr/local/bin/<name>
  # - apps/*.desktop → /usr/local/share/applications/
  # - bind-paths.list → extra probe-path mounts (bin/<name> → listed paths)
  # - config/xdg/mimeapps.list → /etc/xdg/mimeapps.list
  # Extend: add bin + optional desktop/MIME and/or bind-paths.list lines.
  local host_open_dir="${script_dir}/host-open"
  local host_open_bin
  if [[ -d "${host_open_dir}/bin" ]]; then
    for host_open_bin in "${host_open_dir}/bin"/*; do
      [[ -x "${host_open_bin}" ]] || continue
      _mount_args+=("-v" "${host_open_bin}:/usr/local/bin/$(basename "${host_open_bin}"):ro")
    done
  fi
  local host_open_bind_paths="${host_open_dir}/bind-paths.list"
  if [[ -f "${host_open_bind_paths}" ]]; then
    local host_open_handler host_open_dest host_open_src
    while read -r host_open_handler host_open_dest || [[ -n "${host_open_handler:-}" ]]; do
      [[ -z "${host_open_handler}" || "${host_open_handler}" == \#* ]] && continue
      [[ -n "${host_open_dest}" && "${host_open_dest}" == /* ]] || continue
      host_open_src="${host_open_dir}/bin/${host_open_handler}"
      [[ -x "${host_open_src}" ]] || continue
      _mount_args+=("-v" "${host_open_src}:${host_open_dest}:ro")
    done < "${host_open_bind_paths}"
  fi
  local host_open_desktop
  if [[ -d "${host_open_dir}/apps" ]]; then
    for host_open_desktop in "${host_open_dir}/apps"/*.desktop; do
      [[ -f "${host_open_desktop}" ]] || continue
      _mount_args+=("-v" "${host_open_desktop}:/usr/local/share/applications/$(basename "${host_open_desktop}"):ro")
    done
  fi
  local config_root xdg_mimeapps
  if [[ -d "${script_dir}/../../config/xdg" ]]; then
    config_root="${script_dir}/../../config"
  elif [[ -d "${script_dir}/../config/xdg" ]]; then
    config_root="${script_dir}/../config"
  else
    config_root=""
  fi
  xdg_mimeapps="${config_root}/xdg/mimeapps.list"
  if [[ -n "${config_root}" && -f "${xdg_mimeapps}" ]]; then
    _mount_args+=("-v" "${xdg_mimeapps}:/etc/xdg/mimeapps.list:ro")
  fi

  if [[ -d /etc/fonts ]]; then
    _mount_args+=("-v" "/etc/fonts:/etc/fonts:ro")
  fi
  if [[ -d /usr/share/fonts ]]; then
    _mount_args+=("-v" "/usr/share/fonts:/usr/share/fonts:ro")
  fi
  if [[ -d /usr/local/share/fonts ]]; then
    _mount_args+=("-v" "/usr/local/share/fonts:/usr/local/share/fonts:ro")
  fi
  if [[ -d "${host_home}/.local/share/fonts" ]]; then
    _mount_args+=("-v" "${host_home}/.local/share/fonts:${host_home}/.local/share/fonts:ro")
  fi
  if [[ -d "${host_home}/.fonts" ]]; then
    _mount_args+=("-v" "${host_home}/.fonts:${host_home}/.fonts:ro")
  fi
  if [[ -d "${host_home}/.config/fontconfig" ]]; then
    _mount_args+=("-v" "${host_home}/.config/fontconfig:${host_home}/.config/fontconfig:ro")
  fi
}

# Atomic hosts (Silverblue) keep system accounts in /usr/lib/{passwd,group} (nss altfiles)
# while /etc/{passwd,group} are stubs. Ubuntu images only use nss "files", so merge both.
prepare_host_passwd_group_mounts() {
  local -n _mount_args="$1"
  local host_home="$2"
  local nss_dir="${host_home}/.containers/work_container/nss"
  local passwd_out="${nss_dir}/passwd"
  local group_out="${nss_dir}/group"

  mkdir -p "${nss_dir}"

  if [[ -f /usr/lib/passwd ]]; then
    cat /etc/passwd /usr/lib/passwd | awk -F: '!seen[$1]++' > "${passwd_out}"
  else
    cp -f /etc/passwd "${passwd_out}"
  fi
  if [[ -f /usr/lib/group ]]; then
    cat /etc/group /usr/lib/group | awk -F: '!seen[$1]++' > "${group_out}"
  else
    cp -f /etc/group "${group_out}"
  fi
  # Ensure Debian-style nogroup exists when only Fedora nobody is present (tinyproxy template).
  if ! awk -F: '$1=="nogroup" {found=1} END{exit !found}' "${group_out}"; then
    if awk -F: '$1=="nobody" {print $3; exit}' "${group_out}" | grep -q .; then
      local nobody_gid
      nobody_gid="$(awk -F: '$1=="nobody" {print $3; exit}' "${group_out}")"
      echo "nogroup:x:${nobody_gid}:" >> "${group_out}"
    else
      echo "nogroup:x:65534:" >> "${group_out}"
    fi
  fi
  if ! awk -F: '$1=="nobody" {found=1} END{exit !found}' "${passwd_out}"; then
    echo "nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin" >> "${passwd_out}"
  fi

  _mount_args+=("-v" "${passwd_out}:/etc/passwd:ro")
  _mount_args+=("-v" "${group_out}:/etc/group:ro")
}

# Host /dev bind + privileged: same device nodes and hot-plug as the host (VPN unchanged).
# /run/udev lets libudev (Chrome FIDO/HID, etc.) see add/remove after USB replug.
add_host_usb_devices() {
  local -n _mount_args="$1"

  _mount_args+=("--privileged")
  _mount_args+=("-v" "/dev:/dev:rslave")

  if [[ -d /run/udev ]]; then
    _mount_args+=("-v" "/run/udev:/run/udev:ro")
  fi

  # Mount the pcscd rundir when present so a later-started socket is visible
  # (socket-only checks miss host pcscd that starts after the container).
  if [[ -d /run/pcscd ]]; then
    _mount_args+=("-v" "/run/pcscd:/run/pcscd:rw")
  elif [[ -d /var/run/pcscd ]]; then
    _mount_args+=("-v" "/var/run/pcscd:/var/run/pcscd:rw")
  fi
}
