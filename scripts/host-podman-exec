#!/usr/bin/env bash
# Shared host -> work_container podman exec conventions.
# shellcheck shell=bash

# -i always (stdin for pipes/IDE); -t only when both streams are a real terminal.
podman_exec_stdio_args() {
  PODMAN_EXEC_STDIO=(-i)
  if [[ -t 0 ]] && [[ -t 1 ]]; then
    PODMAN_EXEC_STDIO+=(-t)
  fi
}

work_container_app_home_dir() {
  local host_home="${1:-${HOME}}"
  echo "${host_home}/.containers/work_container/home"
}

work_container_config_dir() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  echo "$(cd "${script_dir}/.." && pwd)/config"
}

# Seed APP_HOME shell rc from shipped config/bashrc and config/profile when missing.
ensure_work_container_shell_rc() {
  local app_home="$1"
  local config_dir="$2"
  local bashrc_src="${config_dir}/bashrc"
  local profile_src="${config_dir}/profile"

  if [[ ! -f "${bashrc_src}" ]]; then
    echo "Missing shipped shell config: ${bashrc_src}" >&2
    return 1
  fi

  if [[ ! -f "${app_home}/.bashrc" ]]; then
    cp "${bashrc_src}" "${app_home}/.bashrc"
  fi

  if [[ -f "${profile_src}" ]] && [[ ! -f "${app_home}/.profile" ]]; then
    cp "${profile_src}" "${app_home}/.profile"
  fi
}

ensure_work_container_app_home() {
  local app_home
  local config_dir="${2:-$(work_container_config_dir)}"
  app_home="$(work_container_app_home_dir "${1:-${HOME}}")"
  mkdir -p "${app_home}/.config" "${app_home}/.cache" "${app_home}/.local/share"
  ensure_work_container_shell_rc "${app_home}" "${config_dir}"
}

# Host IANA timezone (systemd service-start often has no TZ in the environment).
work_container_host_timezone() {
  if [[ -n "${TZ:-}" ]]; then
    echo "${TZ}"
    return 0
  fi

  local tz=""
  if command -v timedatectl >/dev/null 2>&1; then
    tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
  fi
  if [[ -z "${tz}" ]] && [[ -f /etc/timezone ]]; then
    tz="$(tr -d ' \t\n\r' </etc/timezone)"
  fi
  if [[ -z "${tz}" ]]; then
    local resolved=""
    resolved="$(readlink -f /etc/localtime 2>/dev/null || true)"
    if [[ "${resolved}" == */zoneinfo/* ]]; then
      tz="${resolved#*/zoneinfo/}"
    fi
  fi
  [[ -n "${tz}" ]] || tz="UTC"
  echo "${tz}"
}

# Mount zoneinfo file directly; bind-mounting /etc/localtime symlink often leaves UTC in the container.
podman_append_host_timezone_mounts() {
  local -n _mount_args="$1"
  local tz="$2"

  if [[ -f "/usr/share/zoneinfo/${tz}" ]]; then
    _mount_args+=("-v" "/usr/share/zoneinfo/${tz}:/etc/localtime:ro")
  elif [[ -e /etc/localtime ]]; then
    _mount_args+=("-v" "/etc/localtime:/etc/localtime:ro")
  fi
  if [[ -f /etc/timezone ]]; then
    _mount_args+=("-v" "/etc/timezone:/etc/timezone:ro")
  fi
}

work_container_host_groups_csv() {
  local groups_csv
  local gid
  groups_csv="$(id -G | tr ' ' ',')"
  if [[ -e /dev/dri/renderD128 ]]; then
    gid="$(stat -c '%g' /dev/dri/renderD128)"
    if [[ -n "${gid}" ]] && [[ ",${groups_csv}," != *",${gid},"* ]]; then
      groups_csv="${groups_csv},${gid}"
    fi
  fi
  if [[ -e /dev/dri/card0 ]]; then
    gid="$(stat -c '%g' /dev/dri/card0)"
    if [[ -n "${gid}" ]] && [[ ",${groups_csv}," != *",${gid},"* ]]; then
      groups_csv="${groups_csv},${gid}"
    fi
  fi
  echo "${groups_csv}"
}

# Host GUI session vars for app launches (DISPLAY, Wayland, audio, VA-API).
podman_append_gui_session_env() {
  local -n _env_args="$1"
  local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  local session_bus="unix:path=${runtime_dir}/bus"

  [[ -n "${DISPLAY:-}" ]] && _env_args+=(--env "DISPLAY=${DISPLAY}")
  [[ -n "${XAUTHORITY:-}" ]] && _env_args+=(--env "XAUTHORITY=${XAUTHORITY}")
  [[ -n "${WAYLAND_DISPLAY:-}" ]] && _env_args+=(--env "WAYLAND_DISPLAY=${WAYLAND_DISPLAY}")
  _env_args+=(--env "XDG_RUNTIME_DIR=${runtime_dir}")
  _env_args+=(--env "XDG_SESSION_TYPE=wayland")
  _env_args+=(--env "DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-${session_bus}}")
  [[ -n "${PULSE_SERVER:-}" ]] && _env_args+=(--env "PULSE_SERVER=${PULSE_SERVER}")
  [[ -n "${PIPEWIRE_REMOTE:-}" ]] && _env_args+=(--env "PIPEWIRE_REMOTE=${PIPEWIRE_REMOTE}")
  [[ -n "${LIBVA_DRIVER_NAME:-}" ]] && _env_args+=(--env "LIBVA_DRIVER_NAME=${LIBVA_DRIVER_NAME}")
  [[ -n "${LIBVA_DRIVERS_PATH:-}" ]] && _env_args+=(--env "LIBVA_DRIVERS_PATH=${LIBVA_DRIVERS_PATH}")
  [[ -n "${VDPAU_DRIVER:-}" ]] && _env_args+=(--env "VDPAU_DRIVER=${VDPAU_DRIVER}")
  _env_args+=(--env "TZ=${TZ:-$(work_container_host_timezone)}")
  return 0
}

# Set on podman run in service-start only; podman exec inherits container env.
work_container_run_app_home_env() {
  local -n _run_env_args="$1"
  local app_home="$2"
  local host_home="$3"

  _run_env_args+=(-e "HOME=${app_home}")
  _run_env_args+=(-e "XDG_CONFIG_HOME=${app_home}/.config")
  _run_env_args+=(-e "XDG_CACHE_HOME=${app_home}/.cache")
  _run_env_args+=(-e "XDG_DATA_HOME=${app_home}/.local/share")
  _run_env_args+=(-e "BROWSER=/usr/local/bin/chrome-work-open")
  _run_env_args+=(-e "WORK_CONTAINER_HOST_HOME=${host_home}")
}

# Run a command in work_container as the calling host user (setpriv).
# Usage: work_container_exec_as_user [podman exec flags...] -- command [args...]
# Set WORK_CONTAINER_EXEC_STDIO=probe for stdin-only (-i) helper execs.
work_container_exec_as_user() {
  local -a podman_args=()
  local -a cmd=()
  local saw_sep=0
  local arg

  for arg in "$@"; do
    if [[ "${saw_sep}" -eq 0 ]] && [[ "${arg}" == "--" ]]; then
      saw_sep=1
      continue
    fi
    if [[ "${saw_sep}" -eq 1 ]]; then
      cmd+=("${arg}")
    else
      podman_args+=("${arg}")
    fi
  done

  if [[ "${#cmd[@]}" -eq 0 ]]; then
    echo "work_container_exec_as_user: missing command after --" >&2
    return 1
  fi

  if [[ "${WORK_CONTAINER_EXEC_STDIO:-}" == probe ]]; then
    PODMAN_EXEC_STDIO=(-i)
  else
    podman_exec_stdio_args
  fi

  sudo podman exec "${PODMAN_EXEC_STDIO[@]}" "${podman_args[@]}" work_container \
    setpriv --reuid "$(id -u)" --regid "$(id -g)" --groups "$(work_container_host_groups_csv)" -- \
    "${cmd[@]}"
}
