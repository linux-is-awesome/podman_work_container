[Desktop Entry]
Type=Application
Version=1.0
Name=Firefox (Work)
Comment=Firefox from work_container
Exec=__RUNNER_BIN__ firefox %U
Icon=firefox-dev
Terminal=false
Categories=Network;WebBrowser;
MimeType=application/pdf;application/vnd.mozilla.xul+xml;application/xhtml+xml;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=Firefox-work
