#!/bin/sh
# Bind-mounted on /usr/bin/google-chrome-stable (and /usr/local/bin/google-chrome).
# Must exec the Chrome binary, not google-chrome-stable (that path is this script).
# Used as BROWSER for xdg-open / tools that need one executable path.
exec /opt/google/chrome/chrome \
  --enable-features=UseOzonePlatform \
  --ozone-platform-hint=auto \
  --ozone-platform=wayland \
  --font-render-hinting=full \
  --class=Google-chrome-work \
  --name=Google-chrome-work \
  "$@"
