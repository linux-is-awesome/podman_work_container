#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=resolve-paths
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/resolve-paths"
# shellcheck source=host-podman-exec
source "${SCRIPT_DIR}/host-podman-exec"

if [[ $# -eq 0 ]]; then
  echo "Usage: ./start exec-in <command> [args...]" >&2
  exit 1
fi

if ! ps_names="$(sudo podman ps --format '{{.Names}}' 2>/dev/null)"; then
  echo "Cannot access root podman. Run ./start install (adds sudoers rule) or authenticate with: sudo -v" >&2
  exit 1
fi

if ! grep -qx 'work_container' <<< "${ps_names}"; then
  echo "work_container service is not running. Start it with: ./start service-start" >&2
  exit 1
fi

CMD=("$@")

# Insert browser flags after the binary so any URL/file args stay last.
if [[ "${CMD[0]}" == "google-chrome" ]] || [[ "${CMD[0]}" == "google-chrome-stable" ]]; then
  CMD=(
    "${CMD[0]}"
    "--enable-features=UseOzonePlatform"
    "--ozone-platform-hint=auto"
    "--ozone-platform=wayland"
    "--font-render-hinting=full"
    "--class=Google-chrome-work"
    "--name=Google-chrome-work"
    "${CMD[@]:1}"
  )
fi
if [[ "${CMD[0]}" == "firefox" ]] || [[ "${CMD[0]}" == "firefox-esr" ]]; then
  CMD=(
    "${CMD[0]}"
    "--class"
    "Firefox-work"
    "--name"
    "Firefox-work"
    "${CMD[@]:1}"
  )
fi
if [[ "${CMD[0]}" == "sf" ]] || [[ "${CMD[0]}" == "sfdx" ]]; then
  has_browser_flag=0
  for arg in "${CMD[@]}"; do
    if [[ "${arg}" == "--browser" ]] || [[ "${arg}" == --browser=* ]] || [[ "${arg}" == "-b" ]]; then
      has_browser_flag=1
      break
    fi
  done

  if [[ "${has_browser_flag}" -eq 0 ]] && [[ "${#CMD[@]}" -ge 2 ]]; then
    HELP_CMD=("${CMD[0]}")
    for ((i=1; i<${#CMD[@]}; i++)); do
      arg="${CMD[$i]}"
      if [[ "${arg}" == -* ]]; then
        break
      fi
      HELP_CMD+=("${arg}")
    done
    HELP_CMD+=(--help)

    WORK_CONTAINER_EXEC_STDIO=probe
    if work_container_exec_as_user -- "${HELP_CMD[@]}" 2>/dev/null | awk '/--browser/ {found=1} END {exit found?0:1}'; then
      CMD+=(--browser chrome)
    fi
    unset WORK_CONTAINER_EXEC_STDIO
  fi
fi

EXEC_ARGS=()
podman_append_gui_session_env EXEC_ARGS
if [[ -n "${PWD:-}" ]]; then
  EXEC_ARGS+=(--workdir "${PWD}")
fi

work_container_exec_as_user "${EXEC_ARGS[@]}" -- "${CMD[@]}"
